# Local Claude Code settings. Machine-specific, never shared.
.claude/settings.local.json

# Agent worktrees. Transient, and each is its own git repo.
.claude/worktrees/

# .NET build output. Regenerated by every build, never shared.
[Bb]in/
[Oo]bj/
# The Plugin's commands, which Claude Code puts on PATH. Written by hand, not built.
!plugins/skillworks/bin/

# Node.
node_modules/
dist/
.vite/
*.tsbuildinfo

# JetBrains Rider and Visual Studio. Machine-specific.
.idea/
.vs/
*.user

# Environment files. May hold secrets.
.env
.env.local

# Borrowed research notes. Reference only, kept local.
docs/research/

# Spec loop run logs. Transient, per-machine.
.spec-loop/

# Handoff documents from one agent session to the next. Transient, per-machine.
.handoff/

# Prototypes. A prototype is a throwaway and never reaches main.
prototypes/

# Python bytecode and test caches. Rebuilt on every run, per-machine.
__pycache__/
.pytest_cache/

# Python virtual environments. Per-machine.
.venv/
venv/
