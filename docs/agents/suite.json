{
  "runs": 2,
  "checks": [
    {
      "command": ["dotnet", "test", "tests/Skillworks.Architecture.Tests"],
      "folder": "."
    },
    {
      "command": ["dotnet", "test", "Skillworks.Studio.slnf",
                  "--blame-crash", "--blame-crash-dump-type", "mini"],
      "folder": ".",
      "ready": {
        "command": ["docker", "info"],
        "message": "Docker does not answer, and the API tests start Loki in a container. Start Docker and run this again."
      },
      "ignores": [
        ".claude",
        "docs",
        "tools",
        "README.md",
        "CLAUDE.md",
        "CONTEXT-MAP.md",
        "LICENSE",
        "NOTICE",
        "THIRD-PARTY-NOTICES.md",
        "aspire.config.json",
        "src/Skillworks.Architecture",
        "src/Skillworks.Studio.Web",
        "src/Skillworks.AppHost/Program.cs",
        "src/Skillworks.AppHost/Skillworks.AppHost.csproj",
        "src/Skillworks.AppHost/Properties",
        "src/Skillworks.AppHost/*.json",
        "src/Skillworks.AppHost/*.yaml",
        "tests/Skillworks.Architecture.Tests",
        "tests/plugins",
        "plugins/.claude-plugin",
        "plugins/skillworks/.claude-plugin",
        "plugins/skillworks/bin",
        "plugins/skillworks/hooks",
        "plugins/skillworks/output-styles",
        "plugins/skillworks/skills",
        "plugins/skillworks/scripts/hooks",
        "plugins/skillworks/scripts/*.py"
      ]
    },
    {
      "command": ["uv", "run", "--with", "pytest", "--with", "pytest-xdist", "--with", "filelock",
                  "pytest", "-n", "auto", "tests/plugins/skillworks/scripts", "-m", "not this_repo"],
      "folder": ".",
      "image": "docs/agents/script-tests.Dockerfile",
      "ignores": [
        ".claude",
        "tools",
        "docs/adr",
        "docs/studio",
        "docs/assets",
        "src/*.cs",
        "src/Skillworks.AppHost",
        "src/Skillworks.Studio.Web/src",
        "tests/Skillworks.Core.Tests/*.cs",
        "tests/Skillworks.Architecture.Tests/*.cs",
        "tests/plugins/skillworks/scripts/*.mjs",
        "plugins/skillworks/scripts/*.mjs"
      ]
    },
    {
      "command": ["uv", "run", "--with", "pytest", "pytest",
                  "tests/plugins/skillworks/scripts/suite_test.py", "-m", "this_repo"],
      "folder": "."
    },
    {
      "command": ["node", "--test", "tests/plugins/skillworks/scripts/**/*.test.mjs"],
      "folder": "."
    },
    {
      "command": ["claude", "plugin", "validate", "plugins/skillworks"],
      "folder": ".",
      "ignores": [
        ".claude",
        "docs",
        "src",
        "tests",
        "tools",
        "README.md",
        "CLAUDE.md",
        "CONTEXT-MAP.md",
        "LICENSE",
        "NOTICE",
        "THIRD-PARTY-NOTICES.md",
        "aspire.config.json",
        "Skillworks.slnx",
        "Skillworks.Studio.slnf",
        "plugins/.claude-plugin"
      ]
    },
    {
      "command": ["npm", "run", "typecheck"],
      "folder": "src/Skillworks.Studio.Web",
      "ready": {
        "command": ["npm", "ci"],
        "message": "The front end has nothing installed, and npm ci would not install it.",
        "unless": "src/Skillworks.Studio.Web/node_modules"
      }
    },
    {
      "command": ["npm", "run", "lint"],
      "folder": "src/Skillworks.Studio.Web"
    },
    {
      "command": ["npm", "test"],
      "folder": "src/Skillworks.Studio.Web"
    }
  ]
}
