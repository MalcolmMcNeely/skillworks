{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(git -C:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(skillworks-preflight:*)",
      "Bash(spec-loop:*)",
      "Bash(land-ticket:*)",
      "Bash(ticket-worktree:*)",
      "Bash(uv run --with pytest pytest:*)",
      "Bash(dotnet:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(aspire:*)",
      "Bash(aspire.cmd:*)",
      "Bash(docker:*)",
      "Bash(mkdir:*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "extraKnownMarketplaces": {
    "skillworks": {
      "source": {
        "source": "directory",
        "path": "./plugins"
      }
    }
  },
  "enabledPlugins": {
    "skillworks@skillworks": true
  },
  "autoMemoryEnabled": false,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h"
}
